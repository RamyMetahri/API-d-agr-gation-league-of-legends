# Clé Riot : https://developer.riotgames.com (la clé de dev expire toutes les 24 h)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Connexion PostgreSQL
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/riot_stats

# Origines autorisées par le CORS (séparées par des virgules), ex : l'URL Vercel du front
CORS_ORIGINS=
# localhost et 127.0.0.1 sont autorisés sur tous les ports par défaut (développement)
# CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?

# Nombre max de requêtes par minute et par IP sur les routes qui appellent Riot
RATE_LIMIT_PAR_MINUTE=60
