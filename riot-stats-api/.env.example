# Clé Riot : https://developer.riotgames.com (la clé de dev expire toutes les 24 h)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Connexion PostgreSQL
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/riot_stats

# Origines autorisées par le CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nombre max de requêtes par minute et par IP sur les routes qui appellent Riot
RATE_LIMIT_PAR_MINUTE=60
